source("~/Documents/AP-1/A2_Quang/AP1-A2_Quang.R")
library(tidyverse)
library(scales) # Used for percentage formatting in Q4 plots
# ==============================================================================
# SETUP: DATA LOADING & MERGING
# ==============================================================================
# Read data
matches_raw <- read_csv("Matches.csv")
stadiums <- read_csv("Stadiums.csv")
teams <- read_csv("Teams.csv")
tournaments <- read_csv("Tournaments.csv")
# Merge datasets to have all necessary columns (Country, TournamentName) in one place
matches_joined <- matches_raw %>%
left_join(stadiums, by = "StadiumID") %>%
left_join(tournaments, by = "TournamentID")
# TEST: Check if the join was successful and structure is correct
glimpse(matches_joined)
source("~/Documents/AP-1/A2_Quang/AP1-A2_Quang.R")
